---

<button class="theme-toggle" type="button" aria-label="Switch to the dark side" aria-pressed="false">
  <span class="track"><span class="thumb"></span></span>
</button>

<script>
  const KEY = 'theme';
  const toggles = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');

  function systemIsDark() {
    return matchMedia('(prefers-color-scheme: dark)').matches;
  }

  function currentTheme(): 'light' | 'dark' {
    const set = document.documentElement.getAttribute('data-theme');
    return set === 'dark' || set === 'light' ? set : (systemIsDark() ? 'dark' : 'light');
  }

  function reflect(theme: 'light' | 'dark') {
    toggles.forEach((t) => {
      t.setAttribute('aria-pressed', String(theme === 'dark'));
      t.setAttribute('aria-label', theme === 'dark' ? 'Switch to the light side' : 'Switch to the dark side');
    });
  }

  const stored = localStorage.getItem(KEY);
  if (stored === 'dark' || stored === 'light') document.documentElement.setAttribute('data-theme', stored);
  reflect(currentTheme());

  toggles.forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const next = currentTheme() === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem(KEY, next);
      reflect(next);
    });
  });
</script>

<style>
  .theme-toggle {
    background: none;
    border: none;
    padding: 0;
    margin-left: 1.5rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
  }
  /* Dark side / light side: a lightsaber-glow toggle. Deliberately its own
     fixed black-void palette rather than the site's tokens — red vs. blue
     glow reads as unmistakably Star Wars without reproducing any character's
     likeness (no Vader mask, just the classic saber colors). */
  .track {
    width: 2.4rem;
    height: 1.3rem;
    background: #0a0a0a;
    border: 1px solid #333;
    border-radius: 999px;
    position: relative;
    box-sizing: border-box;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
    box-shadow: 0 0 6px 1px rgba(79, 195, 247, 0.45);
  }
  .thumb {
    position: absolute;
    top: 50%;
    left: 2px;
    width: 0.95rem;
    height: 0.95rem;
    background: #bfe9ff;
    border-radius: 50%;
    transform: translateY(-50%);
    transition: transform 0.15s ease, background 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 0 5px 1px rgba(79, 195, 247, 0.9);
  }
  .theme-toggle[aria-pressed="true"] .track {
    border-color: #4a1410;
    box-shadow: 0 0 7px 1px rgba(227, 53, 13, 0.55);
  }
  .theme-toggle[aria-pressed="true"] .thumb {
    transform: translateY(-50%) translateX(1.05rem);
    background: #ff5a3c;
    box-shadow: 0 0 6px 1px rgba(227, 53, 13, 0.95);
  }
</style>
